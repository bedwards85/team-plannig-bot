{
  "name": "weekly-coach-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A weekly planning coach bot: Monday plan, mid-week check-in, Friday review, logged against team OKRs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "tsx scripts/chat.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
